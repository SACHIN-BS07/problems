/* Structure of Doubly Linked List Node
class Node {
    int data;
    Node next;
    Node prev;

    Node(int data) {
        this.data = data;
        this.next = null;
        this.prev = null;
    }
}
*/
class Solution {
    public Node reverse(Node head) {
        // code here
        if(head==null || head.next==null){
            return head;
        }
        
        Node  cur=head,temp=null;
        
        while(cur!=null){
            
        temp=cur.prev;
        cur.prev=cur.next;
        cur.next=temp;
        cur=cur.prev;
        }
      if(temp!=null){
          head=temp.prev;
      }
      return head;
    }
}
